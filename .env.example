MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
MUSE_AGENT_MODEL=muse-wonder-1.0
INSPECT_PROMPT=v1
MUSE_REASONING_EFFORT=minimal
WALKWAY_CONCEPT=yellow line
WALKWAY_MIN_CONFIDENCE=0.6
REQUEST_TIMEOUT_S=90
SCAN_TIMEOUT_S=120
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]

AGENT_RUNTIME=langchain
DEMO_MODE=
PRIVACY_BLUR=true
REVIEW_CONFIDENCE=0.6
CACHE_TTL_DAYS=7
GUARD_MAX_TOOL_CALLS=8

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
SCORE_MIN_REVIEWS=5
SCORE_WEIGHTS={"validity":0.4,"guard_clean":0.4,"within_cap":0.2}
MLFLOW_TRACKING_URI=sqlite:///data/mlflow/mlflow.db
